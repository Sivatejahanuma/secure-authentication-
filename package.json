{
  "name": "securex-platform",
  "version": "1.0.0",
  "description": "Production-quality full-stack Secure User Authentication platform",
  "private": true,
  "scripts": {
    "start": "node backend/server.js",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "build": "npm --prefix frontend run build",
    "test:backend": "node backend/test-api.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "authentication",
    "jwt",
    "bcrypt",
    "security",
    "express",
    "react"
  ],
  "author": "SECUREX Engineering",
  "license": "MIT"
}
